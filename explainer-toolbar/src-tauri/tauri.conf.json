{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Explainer Toolbar",
  "version": "0.1.0",
  "identifier": "com.explainertoolbar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Explainer Toolbar",
    "copyright": "© 2026 Explainer Toolbar",
    "category": "Productivity",
    "shortDescription": "Draw, point and explain over any Windows application",
    "longDescription": "A floating toolbar and click-through drawing layer for presentations, lessons and screen explanations.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
