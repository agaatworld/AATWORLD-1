<?xml version="1.0" encoding="utf-8"?>
<!-- Full version only: "عيون كلود" accessibility service. Play Protect blocks sideloaded apps that have one,
     so the lite flavor leaves it out. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".ClawdEyes"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="فشّة خلق — عيون كلود">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/clawd_a11y" />
        </service>
    </application>
</manifest>
